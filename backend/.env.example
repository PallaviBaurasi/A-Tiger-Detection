# Database configuration
DATABASE_URL=sqlite:///./pench_wildlife.db
# JWT Configuration
JWT_SECRET=pench_reserve_secret_key_2026_super_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage configuration
STORAGE_PATH=./storage

# ML & Detection Thresholds
ML_MODE=demo
DETECTION_MODEL_PATH=./models/yolov8_tiger.pt
EMBEDDING_MODEL_PATH=./models/stripe_resnet50.pth

# Configurable Triage & Identification Thresholds
BLANK_THRESHOLD=0.90
MATCH_THRESHOLD=0.85
REVIEW_THRESHOLD=0.65

# GIS & Alert Range Shift Thresholds (km²)
CORE_RANGE_THRESHOLD=15.0
BUFFER_RANGE_THRESHOLD=5.0
PROLONGED_ABSENCE_DAYS=30
